# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tourpackage
DB_USERNAME=tourpackage
DB_PASSWORD=tourpackage
DB_POOL_SIZE=10

# --- Server ---
SERVER_PORT=8080

# --- Frontend (used to build links in emails: reset-password, verify-email) ---
FRONTEND_URL=http://localhost:3000

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---
# Must be at least 32 characters for HS256 signing.
JWT_SECRET=change-this-development-only-secret-key-min-32-chars
JWT_EXPIRATION_MS=3600000
# 30 days
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Auth / account security ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRATION_HOURS=24

# --- Mail (SMTP) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@tourpackage.com
# Where new-booking notifications are sent.
MAIL_ADMIN_NOTIFICATIONS=bookings@tourpackage.com

# --- Booking ---
# A child's share of the adult package price, as a percentage.
CHILD_PRICE_PERCENT=70

# --- Logging ---
LOG_LEVEL=DEBUG

# --- Media storage ---
# Which StorageService implementation is active: local (default), s3, cloudinary.
# See the Image Management section of the README for adding a provider.
STORAGE_PROVIDER=local
# Where LocalStorageService writes files, relative to the working directory.
STORAGE_LOCAL_DIR=./uploads
# Servlet path the files are served from.
STORAGE_SERVE_PATH=/uploads
# Absolute base URL stored against each asset. Must be reachable by the browser
# — the frontend runs on a different origin, so a relative path will not resolve.
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/uploads

# --- Image processing ---
# Longest side of a stored image; anything larger is scaled down (never up).
IMAGE_MAX_DIMENSION=2400
IMAGE_THUMBNAIL_DIMENSION=400
IMAGE_JPEG_QUALITY=0.82
# Rejected above this size, before any decoding happens.
IMAGE_MAX_UPLOAD_BYTES=10485760
# Servlet limits, which apply before IMAGE_MAX_UPLOAD_BYTES and so must be higher.
MULTIPART_MAX_FILE_SIZE=12MB
MULTIPART_MAX_REQUEST_SIZE=120MB
