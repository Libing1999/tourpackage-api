# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tourpackage
DB_USERNAME=tourpackage
DB_PASSWORD=tourpackage
DB_POOL_SIZE=10

# --- Server ---
SERVER_PORT=8080

# --- Frontend (used to build links in emails: reset-password, verify-email) ---
FRONTEND_URL=http://localhost:3000

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---
# Must be at least 32 characters for HS256 signing.
JWT_SECRET=change-this-development-only-secret-key-min-32-chars
JWT_EXPIRATION_MS=3600000
# 30 days
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Auth / account security ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRATION_HOURS=24

# --- Mail (SMTP) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Set false to stop delivery without removing the settings above — messages are
# logged instead. Useful for demos and load tests that shouldn't mail real people.
MAIL_ENABLED=true
MAIL_FROM=no-reply@tourpackage.com
# Sender display name, and the brand used throughout the templates.
MAIL_FROM_NAME=TourPackage
# Where booking, enquiry and newsletter notifications are sent.
MAIL_ADMIN_NOTIFICATIONS=bookings@tourpackage.com
# Replies land here rather than at the no-reply MAIL_FROM address.
MAIL_REPLY_TO=support@tourpackage.com
# Contact address shown in the footer of every email.
MAIL_SUPPORT_EMAIL=support@tourpackage.com
# Optional postal address, appended to the footer's first line.
MAIL_COMPANY_ADDRESS=

# --- Booking ---
# A child's share of the adult package price, as a percentage.
CHILD_PRICE_PERCENT=70

# --- Logging ---
LOG_LEVEL=DEBUG

# --- Media storage ---
# Which StorageService implementation is active: local (default), s3, cloudinary.
# See the Image Management section of the README for adding a provider.
STORAGE_PROVIDER=local
# Where LocalStorageService writes files, relative to the working directory.
STORAGE_LOCAL_DIR=./uploads
# Servlet path the files are served from.
STORAGE_SERVE_PATH=/uploads
# Absolute base URL stored against each asset. Must be reachable by the browser
# — the frontend runs on a different origin, so a relative path will not resolve.
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/uploads

# --- Image processing ---
# Longest side of a stored image; anything larger is scaled down (never up).
IMAGE_MAX_DIMENSION=2400
IMAGE_THUMBNAIL_DIMENSION=400
IMAGE_JPEG_QUALITY=0.82
# Rejected above this size, before any decoding happens.
IMAGE_MAX_UPLOAD_BYTES=10485760
# Servlet limits, which apply before IMAGE_MAX_UPLOAD_BYTES and so must be higher.
MULTIPART_MAX_FILE_SIZE=12MB
MULTIPART_MAX_REQUEST_SIZE=120MB

# --- Search ---
# How close a typo has to be before global search treats it as a match (0-1).
# PostgreSQL's word_similarity default is 0.6, which rejects a single dropped
# letter in a short word. Higher is stricter; lower returns more, less relevant.
SEARCH_FUZZY_THRESHOLD=0.5

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# memory = per instance; redis = shared across a fleet. With `memory` and N
# instances behind a load balancer the effective limit is N times the configured one.
RATE_LIMIT_STORE=memory
# Only enable behind a proxy that OVERWRITES X-Forwarded-For. The header is
# client-settable, so trusting it without one lets any caller bypass every limit.
RATE_LIMIT_TRUST_PROXY=false

# --- Caching ---
CACHE_STORE=memory
# Short by design: these sit in front of content an admin edits and immediately
# reloads to check.
CACHE_TTL_SECONDS=60

# --- Redis (only contacted when a store above is set to `redis`) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# --- API documentation ---
# Publicly readable documentation of every endpoint helps anyone probing the
# API. Turn off in production, or generate the spec in CI instead.
SWAGGER_ENABLED=true
API_VERSION=1.0.0
# Server URL advertised in the OpenAPI document.
API_PUBLIC_URL=http://localhost:8080

# --- Observability ---
# Requests slower than this are logged at WARN with a SLOW marker.
SLOW_REQUEST_MS=1000

# --- Integration tests ---
# Point at a database that can be dropped and rebuilt. CI uses a service container.
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=tourpackage_test
TEST_DB_USERNAME=tourpackage
TEST_DB_PASSWORD=tourpackage
